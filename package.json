{
  "name": "vulnscope",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Desktop security scanner: 274 static-analysis rules, taint tracking, secret detection and CVE lookup, running fully on your machine.",
  "license": "Apache-2.0",
  "author": "MintyExtremum",
  "homepage": "https://github.com/mintyextremum/vulnscope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintyextremum/vulnscope.git"
  },
  "bugs": {
    "url": "https://github.com/mintyextremum/vulnscope/issues"
  },
  "keywords": [
    "security",
    "sast",
    "static-analysis",
    "vulnerability-scanner",
    "secret-detection",
    "taint-analysis",
    "cve",
    "sarif",
    "tauri",
    "rust"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "audit:contrast": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/contrast-audit.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "audit:sarif": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sarif-audit.mjs",
    "audit:score": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/score-audit.mjs",
    "audit:xml1c": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/xml1c-audit.mjs",
    "audit:excel": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/excel-audit.mjs",
    "audit:cssvars": "node scripts/cssvars-audit.mjs",
    "audit:settings": "node scripts/settings-audit.mjs",
    "check": "npx tsc --noEmit && npm run audit:contrast && npm run audit:i18n && npm run audit:sarif && npm run audit:score && npm run audit:xml1c && npm run audit:excel && npm run audit:cssvars && npm run audit:settings && npm run build",
    "check:rust": "cd src-tauri && cargo test --lib && cargo clippy --lib -- -D warnings",
    "check:all": "npm run check && npm run check:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "highlight.js": "^11.11.1",
    "material-symbols": "^0.45.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^8.2.2"
  }
}
